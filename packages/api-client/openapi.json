{
    "openapi": "3.1.2",
    "info": {
        "title": "REOS API",
        "version": "1.0.0",
        "description": "The REOS REST API used by the mobile app and partner integrations. Version 1 lives under `/api/v1`; breaking changes go to a new version (see ADR 0003)."
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1",
            "description": "Local"
        }
    ],
    "paths": {
        "/app-config": {
            "get": {
                "operationId": "app-config",
                "description": "Public values only (Sentry DSN, PostHog project key), the same ones a\nbrowser receives. `null` means the service is switched off.",
                "summary": "Get the app's runtime settings",
                "tags": [
                    "AppConfig"
                ],
                "responses": {
                    "200": {
                        "description": "`AppConfigResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AppConfigResource"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/health": {
            "get": {
                "operationId": "health",
                "description": "Returns the application name, deployed version and server time.\nNeeds no authentication and never touches the database.",
                "summary": "Check the API is up",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "`HealthResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResource"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "AppConfigResource": {
                "type": "object",
                "properties": {
                    "environment": {
                        "type": "string",
                        "description": "Server environment, used to tag errors and events.",
                        "examples": [
                            "production"
                        ]
                    },
                    "release": {
                        "type": "string",
                        "description": "Deployed REOS version.",
                        "examples": [
                            "0.1.0-dev"
                        ]
                    },
                    "sentry": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "description": "Error tracking, or `null` when switched off.",
                        "properties": {
                            "dsn": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "dsn"
                        ]
                    },
                    "posthog": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "description": "Product analytics, or `null` when switched off.",
                        "properties": {
                            "key": {
                                "type": "string"
                            },
                            "host": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "key",
                            "host"
                        ]
                    }
                },
                "required": [
                    "environment",
                    "release",
                    "sentry",
                    "posthog"
                ],
                "title": "AppConfigResource"
            },
            "HealthResource": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "Always `ok` when the application can serve requests.",
                        "const": "ok"
                    },
                    "app": {
                        "type": "string",
                        "description": "Application name.",
                        "examples": [
                            "REOS"
                        ]
                    },
                    "version": {
                        "type": "string",
                        "description": "Deployed REOS version.",
                        "examples": [
                            "0.1.0-dev"
                        ]
                    },
                    "time": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Server time (ISO 8601)."
                    }
                },
                "required": [
                    "status",
                    "app",
                    "version",
                    "time"
                ],
                "title": "HealthResource"
            }
        }
    }
}