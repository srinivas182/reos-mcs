{
    "name": "@reos/tokens",
    "version": "0.1.0",
    "private": true,
    "description": "REOS design tokens shared by the web app and the mobile app",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./tokens.css": "./src/generated/tokens.css",
        "./tailwind.css": "./src/generated/tailwind.css",
        "./swatches.json": "./src/generated/swatches.json"
    },
    "scripts": {
        "build": "node scripts/build.ts",
        "check": "node scripts/build.ts --check",
        "test": "node --test 'test/*.test.ts'",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@reos/config": "workspace:*",
        "typescript": "~6.0.3",
        "@types/node": "^22"
    },
    "type": "module"
}
