{
    "name": "reos",
    "private": true,
    "description": "REOS (Real Estate OS) monorepo: Laravel platform and web app, Expo mobile app, shared packages",
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "turbo run dev --parallel",
        "build": "turbo run build",
        "check": "turbo run check",
        "types:check": "turbo run types:check",
        "test": "turbo run test",
        "prepare": "lefthook install",
        "ci:usage": "node scripts/ci-usage.mjs",
        "api:generate": "pnpm --filter @reos/platform api:export && pnpm --filter @reos/api-client generate",
        "dev:setup": "bash scripts/dev-setup.sh",
        "dev:doctor": "bash scripts/dev-doctor.sh",
        "dev:up": "bash scripts/dev-up.sh",
        "dev:down": "docker compose down",
        "dev:reset": "docker compose down --volumes && bash scripts/dev-up.sh",
        "integrations:render": "node scripts/integrations-register.mjs",
        "integrations:check": "node scripts/integrations-register.mjs --check",
        "integrations:status": "node scripts/integrations-register.mjs --status",
        "test:scripts": "node --test 'scripts/__tests__/*.test.mjs'"
    },
    "devDependencies": {
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "lefthook": "^2.2.2",
        "turbo": "^2.5.0",
        "yaml": "^2.9.1"
    }
}
