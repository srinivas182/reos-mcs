{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reos.dev/schemas/integrations-register.json",
  "title": "REOS integrations register",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "sprint_one_starts", "pilot", "entries"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "format": "date" },
    "sprint_one_starts": { "type": "string", "format": "date" },
    "pilot": { "type": "string", "format": "date" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "connection": {
      "description": "How the super admin connects this service in Settings › Integrations (Sprint 2.4). The product reads it from the generated catalogue.",
      "type": "object",
      "additionalProperties": false,
      "required": ["auth", "accounts", "fields"],
      "properties": {
        "auth": {
          "description": "oauth2 shows the redirect address to register with the vendor; aws uses an IAM access key; none = public data, no keys.",
          "enum": ["api_key", "oauth2", "aws", "none"]
        },
        "accounts": {
          "description": "Whose account the data comes from once the keys are saved: REOS's own (platform), each person connects their own (user), or each brokerage or school connects its own (tenant).",
          "enum": ["platform", "user", "tenant"]
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "description": "Field name. Its label is integrations.fields.<key> in packages/i18n.",
          "enum": ["client_id", "client_secret", "client_key", "api_key", "api_secret", "secret_key", "publishable_key", "webhook_secret", "webhook_id", "access_key_id", "secret_access_key", "region", "account_sid", "auth_token", "from_number", "from_email", "access_token", "access_token_id", "dsn", "browser_dsn", "mobile_dsn", "project_key", "host", "otlp_endpoint", "instance_id", "server_url", "api_login_id", "transaction_key", "signature_key", "integration_key", "private_key", "system_name", "system_key", "app_id", "app_secret", "model_id", "ios_client_id", "team_id", "key_id", "verify_service_sid", "api_token", "zone_id", "cname_target", "sns_topic_arn", "stock_avatar", "stock_avatar_id", "background", "voice_id_en", "voice_id_es"]
        },
        "secret": { "description": "Encrypted and never shown again after saving (only the last four characters).", "type": "boolean" },
        "required": { "description": "Defaults to true.", "type": "boolean" },
        "kind": { "description": "Input type and validation. Defaults to text.", "enum": ["text", "url", "email", "phone", "multiline"] },
        "default": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "category", "purpose", "launch", "build", "owner", "access", "sandbox", "credentials", "personal_data", "cost"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 2 },
        "kind": { "enum": ["integration", "platform_service", "account", "approval"] },
        "category": {
          "enum": ["identity", "calendar_email", "voice", "payments", "notifications", "video", "ai", "crm", "transactions", "esignature", "mls", "lookups", "social", "maps", "accounting", "association", "operations", "platform", "regulatory", "meetings", "leads", "contacts"]
        },
        "purpose": { "type": "string", "minLength": 5 },
        "launch": {
          "description": "Back-office catalogue status at the pilot. not_applicable for services users never connect themselves.",
          "enum": ["enabled", "beta", "coming_soon", "not_applicable"]
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sprint", "item"],
          "properties": {
            "sprint": { "type": "integer", "minimum": 1, "maximum": 20 },
            "item": { "type": "string", "pattern": "^([AB]?[0-9]{1,2}\\.[0-9])$" }
          }
        },
        "owner": { "enum": ["client", "mayura", "client_with_mayura", "nelle", "tenant"] },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "lead_time_weeks", "needed_by_sprint", "status"],
          "properties": {
            "route": { "enum": ["self_serve", "partner_application", "oauth_verification", "app_review", "data_licence", "contract", "security_assessment"] },
            "lead_time_weeks": { "type": "integer", "minimum": 0, "maximum": 52 },
            "needed_by_sprint": { "type": "integer", "minimum": 1, "maximum": 20 },
            "apply_by": {
              "description": "Planned filing date when it must be earlier than needed_by_sprint minus lead_time_weeks (for example, vendors whose approval time is unpredictable).",
              "type": "string",
              "format": "date"
            },
            "status": { "enum": ["not_started", "applied", "in_review", "approved", "blocked", "not_needed"] },
            "applied_on": { "type": "string", "format": "date" },
            "approved_on": { "type": "string", "format": "date" },
            "reference": { "type": "string" }
          },
          "allOf": [
            { "if": { "properties": { "status": { "enum": ["applied", "in_review", "blocked"] } } }, "then": { "required": ["applied_on"] } },
            { "if": { "properties": { "status": { "const": "approved" } } }, "then": { "required": ["applied_on", "approved_on"] } }
          ]
        },
        "sandbox": { "type": "string" },
        "credentials": {
          "description": "platform = REOS partner app keys; tenant = the customer's own account; both; none.",
          "enum": ["platform", "tenant", "both", "none"]
        },
        "personal_data": { "type": "boolean" },
        "cost": { "type": "string" },
        "notes": { "type": "string" },
        "fallback": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "connection": { "$ref": "#/$defs/connection" },
        "mls": {
          "description": "MLS feeds (B10.1): the data vendor that delivers the RESO Web API feed and the dataset it serves. One driver reads every vendor; to_confirm runs on the Simulator only until the MLS names its vendor.",
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "dataset", "short_name"],
          "properties": {
            "vendor": { "enum": ["bridge", "trestle", "mls_grid", "to_confirm"] },
            "dataset": { "description": "Bridge dataset, Trestle feed or MLS Grid OriginatingSystemName.", "type": "string", "pattern": "^[a-z0-9_]+$" },
            "short_name": { "description": "The MLS's name as shown beside its listings.", "type": "string", "minLength": 2 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "integration" } } }, "then": { "properties": { "launch": { "enum": ["enabled", "beta", "coming_soon"] } } } },
        { "if": { "properties": { "kind": { "enum": ["platform_service", "account", "approval"] } } }, "then": { "properties": { "launch": { "const": "not_applicable" } } } }
      ]
    }
  }
}
