{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["public/build/**", "dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "check": {},
        "types:check": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        }
    }
}
