APP_NAME=REOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
REOS_VERSION=0.1.0-dev
OCTANE_SERVER=frankenphp

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local services come from compose.yaml at the repo root (`pnpm dev:up`).
# They listen on 127.0.0.1 only. Override ports in the root .env if they clash.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reos
# A normal user, so row-level security applies (ADR 0015); `reos` is the admin user.
DB_USERNAME=reos_app
DB_PASSWORD=reos-app-local

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Live messages (B6.1): Laravel Reverb, run with `php artisan reverb:start` (scaled with Redis).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=reos-local
REVERB_APP_KEY=reos-local-key
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=s3
# Lesson files (A5.3): uploads go straight here with signed links; set ClamAV to scan them.
REOS_CONTENT_DISK=s3
CLAMAV_HOST=
CLAMAV_PORT=3310
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=reos-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches every e-mail locally: http://localhost:8025
MAIL_MAILER=smtp
# Production: MAIL_MAILER=reos sends through Amazon SES with the keys from Settings › Integrations (B6.2d).
MAIL_REOS_FALLBACK=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@reos.test"
MAIL_FROM_NAME="${APP_NAME}"

# Local S3 is SeaweedFS (http://localhost:8333); production is Amazon S3 in us-east-2.
AWS_ACCESS_KEY_ID=reos
AWS_SECRET_ACCESS_KEY=reos-local-secret
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=reos
AWS_ENDPOINT=http://127.0.0.1:8333
AWS_URL=http://127.0.0.1:8333/reos
AWS_USE_PATH_STYLE_ENDPOINT=true

# Search (Scout driver arrives with the search sprint)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=reos-local-master-key

# Every seeded demo persona uses this password (never seeded in production)
REOS_DEMO_PASSWORD=password

# Encrypts integration keys saved in Settings › Integrations (separate from APP_KEY).
# `pnpm dev:setup` creates it with `php artisan reos:credentials:key`.
REOS_CREDENTIALS_KEY=
REOS_CREDENTIALS_PREVIOUS_KEYS=

VITE_APP_NAME="${APP_NAME}"

# Tenants sign in at <slug>.<this domain> (A4.2a). Browsers send *.localhost
# to this computer, so locally try http://texas-realtors.localhost:8000/login.
REOS_TENANT_BASE_DOMAIN=localhost
