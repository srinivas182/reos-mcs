# REOS preview settings (P7.0). Copy to deploy/preview/.env and fill in every
# CHANGE-ME. Never commit the filled-in file (it's gitignored).
# Generate secrets with: openssl rand -hex 24

APP_NAME=REOS
APP_ENV=preview
APP_DEBUG=false
APP_KEY=CHANGE-ME-run-bin/deploy.sh-once-to-generate
APP_URL=https://preview.reos.com
REOS_PREVIEW=true
LOG_CHANNEL=stderr
LOG_LEVEL=info

# The database (PostgreSQL 17 + pgvector in Compose).
POSTGRES_PASSWORD=CHANGE-ME
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reos
DB_USERNAME=reos_app
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis

# Live messages: phones and browsers use the public host; the app publishes
# to the Reverb container inside the network.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=reos-preview
REVERB_APP_KEY=reos-preview-key
REVERB_APP_SECRET=CHANGE-ME
REVERB_HOST=preview.reos.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
REVERB_SERVER_SCHEME=http

# Files stay on the server (signed links); no S3 for the preview.
FILESYSTEM_DISK=local
REOS_CONTENT_DISK=local

# Email goes to the Mailpit container, never out.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@preview.reos.com"
MAIL_FROM_NAME="REOS preview"

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=CHANGE-ME

# Personas keep this password; pilot users get their own (bin/pilots.sh).
REOS_DEMO_PASSWORD=CHANGE-ME
REOS_CREDENTIALS_KEY=CHANGE-ME-run-bin/deploy.sh-once-to-generate
REOS_TENANT_BASE_DOMAIN=preview.reos.com

# Cloudflare Tunnel token (Zero Trust › Networks › Tunnels › your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=CHANGE-ME
